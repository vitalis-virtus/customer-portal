# Local test environment of Customer Portal. Copy to .env (ignored by Git) and set local values.
# No real secrets here. See docs/architecture/infrastructure-bootstrap.md.

# --- PostgreSQL test container (compose.test.yaml) ---
TEST_POSTGRES_USER=customer_portal_test
TEST_POSTGRES_PASSWORD=change-me-local-only
TEST_POSTGRES_DB=customer_portal_test
TEST_POSTGRES_PORT=55432

# --- Integration tests (go test -tags=integration ./...) ---
# If you change TEST_POSTGRES_USER, _PASSWORD, _DB or _PORT above, update TEST_DATABASE_URL to match.
# Connection string used by integration tests on the host. Must point to the test database only.
TEST_DATABASE_URL=postgres://customer_portal_test:change-me-local-only@127.0.0.1:55432/customer_portal_test?sslmode=disable

# --- Application configuration: not defined yet ---
# Names and values of application settings (HTTP timeouts and limits, pool settings, keys)
# are defined by platform/config in a later Story. Proposed values: infrastructure-bootstrap.md §5.
